              "shortDescription": {
                "text": "aria-hidden=\"true\" must not be present on the document body"
              },
              "helpUri": "https://dequeuniversity.com/rules/axe/4.13/aria-hidden-body?application=axeAPI",
              "help": {
                "text": "aria-hidden=\"true\" must not be present on the document body\n\nWCAG 1.3.1, WCAG 4.1.2, EN 301 549 9.1.3.1, EN 301 549 9.4.1.2"
              },
              "properties": {
                "tags": [
                  "accessibility",
