  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "eaa-kit",
          "version": "0.1.0",
          "rules": [
            {
              "id": "area-alt",
              "shortDescription": {
                "text": "Active <area> elements must have alternative text"
              },
              "helpUri": "https://dequeuniversity.com/rules/axe/4.13/area-alt?application=axeAPI",
              "help": {
                "text": "Active <area> elements must have alternative text\n\nWCAG 2.4.4, WCAG 4.1.2, EN 301 549 9.2.4.4, EN 301 549 9.4.1.2"
              },
              "properties": {
                "tags": [
                  "accessibility",
                  "wcag-2.4.4",
                  "wcag-4.1.2",
                  "en-301-549-9.2.4.4",
                  "en-301-549-9.4.1.2"
                ]
              }
            },
            {
              "id": "aria-allowed-attr",
              "shortDescription": {
                "text": "Elements must only use supported ARIA attributes"
              },
              "helpUri": "https://dequeuniversity.com/rules/axe/4.13/aria-allowed-attr?application=axeAPI",
              "help": {
                "text": "Elements must only use supported ARIA attributes\n\nWCAG 4.1.2, EN 301 549 9.4.1.2"
              },
