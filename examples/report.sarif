                  "wcag-4.1.2",
                  "en-301-549-9.4.1.2"
                ]
              }
            },
            {
              "id": "aria-braille-equivalent",
              "shortDescription": {
                "text": "aria-braille attributes must have a non-braille equivalent"
              },
              "helpUri": "https://dequeuniversity.com/rules/axe/4.13/aria-braille-equivalent?application=axeAPI",
