              "help": {
                "text": "ARIA attributes must be used as specified for the element's role\n\nWCAG 4.1.2, EN 301 549 9.4.1.2"
              },
              "properties": {
                "tags": [
                  "accessibility",
                  "wcag-4.1.2",
                  "en-301-549-9.4.1.2"
                ]
              }
